# ==============================================
# KON - Configuration Environment Variables
# ==============================================

# Server Network Configuration
KON_HOST=127.0.0.1
KON_PORT=8000
KON_DEBUG=true

# AI Provider Configuration (For future phases)
# Supported future providers: openai, anthropic, gemini, local
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Voice Providers (For future phases)
# STT: faster-whisper, whisper-local, speech_recognition
STT_PROVIDER=mock
# TTS: pyttsx3, edge-tts, system
TTS_PROVIDER=system
# Wake Word: porcupine, openwakeword
WAKE_WORD_ENGINE=mock
WAKE_WORD=Okay KON

# Security Level: SAFE, CONFIRM, CRITICAL
KON_SECURITY_MODE=CONFIRM
